{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation.local/schemas/entity-warninglists.schema.json",
  "title": "Constellation entity-resolution warninglists",
  "description": "Warninglist-shaped entity disambiguation rules. Inspired by MISP's simple list contract (CC0) but independently authored. Every list declares a match type, bounded values, and an action: suppress, force_ambiguity, or require_kind. Suppressions must always be reported, never silent.",
  "type": "object",
  "required": ["schema_version", "lists"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "lists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "description", "match_attributes", "values", "action"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "version": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "match_attributes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["exact", "substring", "hostname", "regex"]}
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "action": {"enum": ["suppress", "force_ambiguity", "require_kind"]},
          "entity_kind": {
            "type": ["string", "null"],
            "enum": ["person", "company", "organization", "place", "project", "concept", null],
            "description": "Required when action is require_kind; must be null otherwise."
          }
        }
      }
    }
  }
}
