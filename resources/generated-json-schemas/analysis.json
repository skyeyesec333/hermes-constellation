{
  "$defs": {
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Strategic analysis artifact \u2014 output from a framework run.",
  "properties": {
    "agent_profile": {
      "default": "",
      "title": "Agent Profile",
      "type": "string"
    },
    "chain_id": {
      "anyOf": [
        {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chain Id"
    },
    "chain_position": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chain Position"
    },
    "confidence": {
      "default": "medium",
      "title": "Confidence",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entity_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Entity Id",
      "type": "string"
    },
    "framework": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Framework",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "operator_reviewed": {
      "default": false,
      "title": "Operator Reviewed",
      "type": "boolean"
    },
    "research_inquiries_spawned": {
      "items": {
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Research Inquiries Spawned",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "status": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "supporting_claims": {
      "items": {
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Supporting Claims",
      "type": "array"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "const": "analysis",
      "default": "analysis",
      "title": "Type",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "title",
    "status",
    "sensitivity",
    "created_at",
    "updated_at",
    "framework",
    "entity_id"
  ],
  "title": "Analysis",
  "type": "object"
}
