{
  "$defs": {
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable point-in-time capture of watchlist results.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "material_diff_from": {
      "anyOf": [
        {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Material Diff From"
    },
    "preserved_bytes_sha256": {
      "default": "",
      "title": "Preserved Bytes Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "source_ids": {
      "items": {
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "status": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "const": "snapshot",
      "default": "snapshot",
      "title": "Type",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "watchlist_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Watchlist Id",
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "sensitivity",
    "created_at",
    "updated_at",
    "watchlist_id"
  ],
  "title": "Snapshot",
  "type": "object"
}
