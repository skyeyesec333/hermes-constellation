{
  "$defs": {
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A material change detected between snapshots \u2014 review-only candidate.",
  "properties": {
    "change_summary": {
      "maxLength": 5000,
      "minLength": 1,
      "title": "Change Summary",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entity_ids": {
      "items": {
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "previous_snapshot_id": {
      "anyOf": [
        {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Snapshot Id"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "snapshot_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_candidate_paths": {
      "items": {
        "type": "string"
      },
      "title": "Source Candidate Paths",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "status": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "const": "observation",
      "default": "observation",
      "title": "Type",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "watchlist_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Watchlist Id",
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "sensitivity",
    "created_at",
    "updated_at",
    "watchlist_id",
    "snapshot_id",
    "change_summary"
  ],
  "title": "Observation",
  "type": "object"
}
