{
  "$defs": {
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_class": {
      "enum": [
        "verified",
        "corroborated",
        "single-source",
        "inferred",
        "user-asserted"
      ],
      "title": "Evidence Class",
      "type": "string"
    },
    "first_seen": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Seen"
    },
    "id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "last_seen": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Seen"
    },
    "object_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Object Id",
      "type": "string"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At"
    },
    "predicate": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Predicate",
      "type": "string"
    },
    "qualifiers": {
      "additionalProperties": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Qualifiers",
      "type": "object"
    },
    "role": {
      "default": "",
      "maxLength": 200,
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "source_ids": {
      "items": {
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "status": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Subject Id",
      "type": "string"
    },
    "supersedes": {
      "items": {
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "const": "relationship",
      "default": "relationship",
      "title": "Type",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    }
  },
  "required": [
    "title",
    "status",
    "sensitivity",
    "created_at",
    "updated_at",
    "subject_id",
    "predicate",
    "object_id",
    "source_ids",
    "evidence_class"
  ],
  "title": "RelationshipRecord",
  "type": "object"
}
